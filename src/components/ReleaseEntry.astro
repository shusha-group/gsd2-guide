---
import { marked } from 'marked';

interface Props {
  tagName: string;
  name: string;
  publishedAt: string;
  htmlUrl: string;
  body: string;
  isLatest: boolean;
  highlight?: string;
}

const { tagName, name, publishedAt, htmlUrl, body, isLatest, highlight } = Astro.props;

// Command slug map — maps command names to their deep-dive page slugs
const commandSlugs: Record<string, string> = {
  '/gsd auto': 'auto',
  '/gsd stop': 'stop',
  '/gsd': 'gsd',
  '/gsd next': 'next',
  '/gsd quick': 'quick',
  '/gsd discuss': 'discuss',
  '/gsd status': 'status',

  '/gsd queue': 'queue',
  '/gsd steer': 'steer',



  '/gsd cleanup': 'cleanup',
  '/gsd doctor': 'doctor',
  '/gsd forensics': 'forensics',
  '/gsd prefs': 'prefs',
  '/gsd mode': 'mode',
  '/gsd migrate': 'migrate',
  '/gsd export': 'export',
  '/gsd update': 'update',
  // Variants without leading slash
  'gsd auto': 'auto',
  'gsd stop': 'stop',
  'gsd next': 'next',
  'gsd quick': 'quick',
  'gsd discuss': 'discuss',
  'gsd status': 'status',

  'gsd queue': 'queue',
  'gsd steer': 'steer',



  'gsd cleanup': 'cleanup',
  'gsd doctor': 'doctor',
  'gsd forensics': 'forensics',
  'gsd prefs': 'prefs',
  'gsd mode': 'mode',
  'gsd migrate': 'migrate',
  'gsd headless': 'headless',
  'gsd sessions': 'headless',
  'gsd config': 'config',
  'gsd update': 'update',
};

let bodyHtml = await marked(body);

// Linkify <code>/gsd X</code> → <a href="..."><code>/gsd X</code></a>
// Match <code> tags containing gsd commands, but skip if already inside an <a>
bodyHtml = bodyHtml.replace(
  /<code>(\/?gsd(?:\s+[\w-]+)?)<\/code>/g,
  (match, command) => {
    const slug = commandSlugs[command];
    if (!slug) return match; // No matching deep-dive page
    return `<a href="/commands/${slug}/" class="command-link"><code>${command}</code></a>`;
  }
);

// Linkify #NNN → GitHub issue/PR links
bodyHtml = bodyHtml.replace(
  /(?<![\w\/"'])#(\d+)\b/g,
  '<a href="https://github.com/gsd-build/gsd-2/issues/$1" target="_blank" rel="noopener noreferrer">#$1</a>'
);

const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<details class="release-entry" open={isLatest}>
  <summary>
    <a href={htmlUrl} target="_blank" rel="noopener noreferrer" class="release-version">
      {tagName}
    </a>
    <span class="release-date">{formattedDate}</span>
  </summary>
  <div class="release-body">
    {highlight && (
      <div class="release-highlight">
        <span class="release-highlight-label">Highlights</span> {highlight}
      </div>
    )}
    <Fragment set:html={bodyHtml} />
  </div>
</details>

<style>
  .release-highlight {
    border-left: 3px solid var(--sl-color-accent);
    background: var(--sl-color-bg-sidebar);
    padding: 0.5rem 0.75rem;
    margin-bottom: 1rem;
    border-radius: 0 0.25rem 0.25rem 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .release-highlight-label {
    font-weight: 600;
    color: var(--sl-color-accent);
    margin-right: 0.25rem;
  }
  .release-highlight-label::after {
    content: " —";
  }
</style>
