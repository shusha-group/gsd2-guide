---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Header.astro';
import releases from '../../content/generated/releases.json';

const version = releases[0]?.tag_name ?? 'v0.0.0';
---

<Default {...Astro.props}><slot /></Default>

<script define:vars={{ version }}>
  // Inject version badge next to the site title after DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const siteTitle = document.querySelector('.site-title');
    if (!siteTitle) return;
    const badge = document.createElement('a');
    badge.href = '/changelog/';
    badge.className = 'version-badge';
    badge.textContent = version;
    siteTitle.parentElement.insertBefore(badge, siteTitle.nextSibling);
  });
</script>

<style is:global>
  .version-badge {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.15rem 0.55rem;
    font-family: var(--sl-font-system-mono, 'JetBrains Mono Variable', monospace);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sl-color-accent-high, #b8ffb0);
    background: var(--sl-color-accent-low, #0f2b0f);
    border: 1px solid var(--sl-color-accent, #39ff14);
    border-radius: 3px;
    opacity: 0.85;
    text-decoration: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    vertical-align: middle;
  }

  .version-badge:hover {
    opacity: 1;
    text-decoration: none;
  }

  @media (max-width: 49.99rem) {
    .version-badge {
      font-size: 0.6rem;
      padding: 0.1rem 0.4rem;
    }
  }
</style>
